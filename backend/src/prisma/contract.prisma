// use prisma-8

model Profile {
  id        Int      @id @default(autoincrement())
  name     String   
  description  String

  experiences     Experience[]
  projects     Project[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}


model Skill {
  id        Int      @id @default(autoincrement())
  name      String

  createdAt TimestamptzString @default(now())
}

model Experience {
  id        Int      @id @default(autoincrement())
  company      String
  position      String
  description      String
  profile_id     Int 

  profile  Profile  @relation(fields: [profile_id], references: [id])

  createdAt TimestamptzString @default(now())
}

model Project {
  id        Int      @id @default(autoincrement())
  name      String
  description      String
  profile_id     Int 

  profile  Profile  @relation(fields: [profile_id], references: [id])

  createdAt TimestamptzString @default(now())
}

// Соединительная таблица для Profile и Skill
model ProfilesSkills {
  profileId     Int
  skillId       Int
  
  // Обязательные связи для Prisma
  profile       Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([profileId, skillId]) // Составной первичный ключ
}