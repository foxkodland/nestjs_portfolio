// use prisma-8

model Profile {
  id        Int      @id @default(autoincrement())
  name     String   
  description  String

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}


model Skill {
  id        Int      @id @default(autoincrement())
  name      String

  createdAt TimestamptzString @default(now())
}
